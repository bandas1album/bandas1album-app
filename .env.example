# URL pública do front (canônico, SEO)
NEXT_PUBLIC_SITE_URL=https://bandas1album.com.br

# Base da API JSON do WordPress headless (sem barra no final).
# Todas as rotas do app são relativas a isso: /api/albums, /jwt-auth/v1/token, etc.
NEXT_PUBLIC_API_URL=https://api.bandas1album.com.br/json

# Segredo compartilhado com o WordPress (Álbuns → Revalidação do front)
# para limpar o cache ISR ao salvar um álbum. Header: Authorization: Bearer …
REVALIDATE_SECRET=

# Segredo do cron de sitemap (Authorization: Bearer …)
CRON_SECRET=